# Copy to .env and fill in your own values. Never commit the real .env.

# PostgreSQL connection string. Required — the server exits without it.
# DATABASE_URL is accepted as a fallback.
Neon_db='postgresql://user:password@host.neon.tech/neondb?sslmode=require&channel_binding=require'

# Port for the HTTP server. Optional, defaults to 8080.
PORT=8080
