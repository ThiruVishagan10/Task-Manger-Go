# Copy to .env and fill in your own values. Never commit the real .env.

# PostgreSQL connection string. Required — the server exits without it.
# DATABASE_URL is accepted as a fallback.
Neon_db='postgresql://user:password@host.neon.tech/neondb?sslmode=require&channel_binding=require'

# Port for the HTTP server. Optional, defaults to 8080.
PORT=8080

# --- Google sign-in (optional) ---------------------------------------------
# Leave both blank to run with email and password only; the /auth/google routes
# then answer 501. Create credentials under "OAuth 2.0 Client IDs" at
# https://console.cloud.google.com/apis/credentials (application type: Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must be registered verbatim as an authorized redirect URI on the OAuth client
# above, or Google rejects the sign-in before the user sees anything.
# Optional, defaults to the value below.
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Where a browser lands once Google sign-in succeeds. Point it at your frontend.
# Optional, defaults to /.
POST_LOGIN_REDIRECT=/

# --- Cookies ----------------------------------------------------------------
# Set to true in production, where the API is served over HTTPS. Leave false for
# local development: a Secure cookie is never sent back over plain HTTP, so
# every login would appear to succeed and then be forgotten.
COOKIE_SECURE=false
